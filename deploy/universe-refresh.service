# Daily D-0026 universe selection.
#
# USER UNIT. Install to ~/.config/systemd/user/ -- see
# trading-engine.service for the SELinux evidence behind that choice.
#
# Type=oneshot: this runs, writes one snapshot, and exits. It is NOT a
# daemon, and it deliberately has no Restart= -- a failed run means no
# snapshot for today, which the engine already reports to the Controller
# through its once-per-day nothing_to_trade_today message (D-0054).
# Retrying blindly would hammer the broker's API instead of telling
# anyone.

[Unit]
Description=Daily D-0026 universe selection (writes today's snapshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Treading-bot-Claude
ExecStart=%h/Treading-bot-Claude/deploy/universe-refresh.sh

# File, not the journal -- /var/log/journal does not exist on this VM
# and Storage=auto makes the journal volatile, so journalctl --user
# reports "No journal files were found". Safe here because a USER unit
# runs as unconfined_t; see trading-engine.service.
#   tail -40 ~/Treading-bot-Claude/logs/universe.log
StandardOutput=append:%h/Treading-bot-Claude/logs/universe.log
StandardError=append:%h/Treading-bot-Claude/logs/universe.log
