# Copy to .env and fill in with your own values. Never commit .env.
# If a secret is ever pasted into a chat log, treat it as compromised and rotate it.

# --- Perplexity Agent API ---
PERPLEXITY_API_KEY=

# --- Alpaca (PAPER TRADING ONLY) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Must be the paper endpoint. Live URLs must be refused at startup.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user ids allowed to Approve/Reject via the bot.
# See docs/architecture/telegram-approval.md and D-0025.
TELEGRAM_ADMIN_USER_IDS=

# --- D-0042 free-source calibration data providers (all optional) ---
# These are used by the D-0026 universe calibration path; the paper trading
# engine does NOT read them and works without any of them. Names only,
# values populated per environment; never commit real values.

# Polygon.io — two credential sets: one for the REST API, three for
# the S3-compatible Flat Files bulk download endpoint.
POLYGON_API_KEY=
POLYGON_S3_ACCESS_KEY_ID=
POLYGON_S3_SECRET_KEY=
POLYGON_S3_ENDPOINT=

# St. Louis Fed FRED — macro time series.
FRED_API_KEY=

# Alpha Vantage — daily/monthly equity + fundamentals (25 req/day free).
ALPHA_VANTAGE_API_KEY=

# Tiingo — end-of-day equities (500 req/hour free).
TIINGO_API_KEY=

# Finnhub — company + limited-history equity data (60 req/min free).
FINNHUB_API_KEY=

# D-0050 Phase B.20: QuiverQuant API key for Congressional trades
# Get from https://api.quiverquant.com (free tier: 150 req/month)
QUIVER_QUANT_API_KEY=
