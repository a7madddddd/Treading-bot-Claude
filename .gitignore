# Logs
logs/
*.log

# Runtime SQLite state (session/proposal/trade DB) -- created at runtime,
# never source. Contains real broker session data; must not be committed.
# Trailing wildcard also catches archived snapshots
# (e.g. paper_session.sqlite.pre-reset-YYYYMMDDTHHMMSSZ).
*.sqlite
*.sqlite*

# Common build/artifact dirs (kept broad; refine when a language is chosen)
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
target/
