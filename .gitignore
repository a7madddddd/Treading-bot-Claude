# Secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
logs/
*.log

# Runtime SQLite state (session/proposal/trade DB).
# Controller-approved 2026-10-01: the single live DB
# `paper_session.sqlite` IS committed so a fresh cloud container
# (whose working directory resets to the git clone on every reclaim)
# can rehydrate yesterday's open trades at startup. Everything else
# matching *.sqlite* (archived snapshots, wal/shm sidecars, test DBs)
# stays ignored.
*.sqlite
*.sqlite*
!paper_session.sqlite
# Lock DB (session-ephemeral, heartbeat-only) stays ignored even
# though *.sqlite* already covers it -- an explicit line here is a
# readability aid for anyone scanning .gitignore.
engine_lock.sqlite

# Common build/artifact dirs (kept broad; refine when a language is chosen)
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
target/
